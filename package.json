{
  "name": "fluency-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@jest/globals": "30.5.2",
    "eslint": "^9.39.5",
    "jest": "30.5.2",
    "lefthook": "2.1.14",
    "prettier": "^3.9.10",
    "vitest": "5.1.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "start": "pnpm --filter @fluency-lab/mobile start",
    "gate": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint && eslint . --ignore-pattern \"apps/**\" --ignore-pattern \"packages/**\" && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test && node --test \"scripts/test/*.test.mjs\""
  }
}
